{
  "name": "turtle-language-server",
  "displayName": "Turtle RDF Language Server (TTL, OWL, SHACL)",
  "description": "Fast Turtle (.ttl) and RDF 1.2 support written in Rust: syntax highlighting, error checking, completion of 80+ vocabularies (rdf, rdfs, owl, skos, shacl, schema.org, foaf), hover docs, go to definition, rename and quick fixes for ontologies and linked data.",
  "version": "0.1.1",
  "publisher": "abhishekkundu25",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishekkundu25/turtle-lsp"
  },
  "homepage": "https://github.com/abhishekkundu25/turtle-lsp#readme",
  "bugs": {
    "url": "https://github.com/abhishekkundu25/turtle-lsp/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0F2A22",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Data Science"
  ],
  "keywords": [
    "turtle",
    "ttl",
    "rdf",
    "rdf 1.2",
    "owl",
    "ontology",
    "shacl",
    "skos",
    "sparql",
    "linked data",
    "semantic web",
    "knowledge graph",
    "schema.org",
    "foaf",
    "lsp",
    "language server",
    "rdfs",
    "triples"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.{ttl,turtle}"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces turtle.server.path is ignored, so the bundled server is always used.",
      "restrictedConfigurations": [
        "turtle.server.path"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The language server reads Turtle files from disk."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "turtle",
        "aliases": [
          "Turtle",
          "turtle"
        ],
        "extensions": [
          ".ttl",
          ".turtle"
        ],
        "mimetypes": [
          "text/turtle"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "turtle",
        "scopeName": "source.turtle",
        "path": "./syntaxes/turtle.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Turtle",
      "properties": {
        "turtle.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `turtle-lsp` binary. Leave empty to use the one bundled with the extension, then `turtle-lsp` on `PATH`. This is a machine setting: a project's own `.vscode/settings.json` cannot change it, so opening a repository never runs a binary it chose.",
          "scope": "machine"
        },
        "turtle.prefixes": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Prefixes available in every Turtle file, e.g. `{ \"ex\": \"http://example.org/\" }`. A `prefixes.ttl` in the project does the same per folder."
        },
        "turtle.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the communication between VS Code and the server (Output panel → Turtle)."
        }
      }
    },
    "commands": [
      {
        "command": "turtle.restartServer",
        "title": "Turtle: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --minify --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/grammar.test.mjs test/manifest.test.mjs && node test/run.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
