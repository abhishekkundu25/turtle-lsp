@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Relative IRIs resolve against the import IRI.
<> a owl:Ontology ;
    owl:imports <http://example.com/ont/ext2> .

<#Widget> a owl:Class ;
    rdfs:label "Widget thing"@en ;
    rdfs:comment "Something with a size." .
