+/// Checks a [`CancellationToken`] every [`Ticker::CHECK_EVERY`] steps of work that reads no data.
+struct Ticker {
+    token: CancellationToken,
+    steps: u32,
+    cancelled: bool,
+}
+
+impl Ticker {
+    const CHECK_EVERY: u32 = 1024;
+
+    fn new(token: CancellationToken) -> Self {
+        Self {
+            token,
+            steps: 0,
+            cancelled: false,
+        }
+    }
+
+    /// Counts one step and returns whether the token is canceled.
+    #[inline]
+    fn tick(&mut self) -> bool {
+        if !self.cancelled {
+            self.steps = self.steps.wrapping_add(1);
+            if self.steps.is_multiple_of(Self::CHECK_EVERY) {
+                self.cancelled = self.token.is_cancelled();
+            }
+        }
+        self.cancelled
+    }
+
+    fn is_cancelled(&self) -> bool {
+        self.cancelled
+    }
+}
