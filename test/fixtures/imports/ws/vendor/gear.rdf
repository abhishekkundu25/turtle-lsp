<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.com/ont/gear#"
     xml:base="http://example.com/ont/gear"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.com/ont/gear"/>
    <!-- A property defined in RDF/XML -->
    <owl:DatatypeProperty rdf:about="#teeth">
        <rdfs:label xml:lang="en">number of teeth</rdfs:label>
        <rdfs:comment>How many teeth the gear has.</rdfs:comment>
    </owl:DatatypeProperty>
</rdf:RDF>
