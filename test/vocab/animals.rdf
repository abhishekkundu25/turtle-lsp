<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:ex="http://example.org/ns#">
  <owl:Ontology rdf:about="http://example.org/ns#">
    <rdfs:label>Animals</rdfs:label>
  </owl:Ontology>
  <owl:Class rdf:about="http://example.org/ns#Animal">
    <rdfs:label xml:lang="fr">animal (fr)</rdfs:label>
    <rdfs:label xml:lang="en">animal</rdfs:label>
    <rdfs:comment>A living thing   that moves.

A second paragraph, which the list drops.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/other#Base"/>
  </owl:Class>
  <rdfs:Class rdf:about="http://example.org/ns#Dog">
    <rdfs:subClassOf rdf:resource="http://example.org/ns#Animal"/>
    <skos:prefLabel>dog</skos:prefLabel>
  </rdfs:Class>
  <owl:ObjectProperty rdf:about="http://example.org/ns#owner">
    <rdfs:label xml:lang="en">owner</rdfs:label>
    <skos:definition>The one&#9;who owns it.</skos:definition>
    <rdfs:domain rdf:resource="http://example.org/ns#Dog"/>
    <rdfs:range rdf:resource="http://example.org/people/Person"/>
    <rdfs:range rdf:resource="http://example.org/other#Agent"/>
  </owl:ObjectProperty>
  <ex:Dog rdf:about="http://example.org/ns#rex">
    <rdfs:label>Rex</rdfs:label>
  </ex:Dog>
  <rdf:Description rdf:about="http://example.org/ns#Puppy">
    <rdfs:subClassOf rdf:resource="http://example.org/ns#Dog"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ns#age">
    <rdfs:domain rdf:resource="http://example.org/ns#Animal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ns#Cat">
    <rdfs:seeAlso rdf:resource="http://example.org/ns#Dog"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ns#legs">
    <rdfs:seeAlso rdf:resource="http://example.org/ns#Dog"/>
  </rdf:Description>
</rdf:RDF>
