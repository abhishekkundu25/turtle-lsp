{
  "comments": { "lineComment": "#" },
  "brackets": [["[", "]"], ["(", ")"], ["<<", ">>"], ["{|", "|}"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "<", "close": ">", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["[", "]"], ["(", ")"], ["<", ">"], ["\"", "\""], ["'", "'"]],
  "wordPattern": "[A-Za-z_\\u00C0-\\uFFFD][\\w.\\-\\u00B7\\u00C0-\\uFFFD]*(:[\\w.\\-%\\u00B7\\u00C0-\\uFFFD]*)?|:[\\w.\\-%\\u00B7\\u00C0-\\uFFFD]+",
  "indentationRules": {
    "increaseIndentPattern": "^((?!#).)*([;\\[({]|\\{\\|)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(\\]|\\)|\\|\\}|\\})"
  },
  "onEnterRules": [
    { "beforeText": "\\.\\s*(#.*)?$", "action": { "indent": "outdent" } }
  ]
}
