obj:pos-mc2 a sd:Position ;
    rdfs:label "Milling cell 2"@en ;
    sd:designation "=MC2" ;
    sd:hasFunction fn:Milling .

obj:mill-0517 a sd:Asset ;
    rdfs:label "Mill 0517" ;
    sd:designation "=MC2.M05" ;
