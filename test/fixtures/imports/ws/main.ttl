@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ext: <http://example.com/ont/ext#> .
@prefix ext2: <http://example.com/ont/ext2#> .
@prefix gear: <http://example.com/ont/gear#> .
@prefix ex: <http://example.com/ont/main#> .

<http://example.com/ont/main> a owl:Ontology ;
    owl:imports <http://example.com/ont/ext>, <http://example.com/ont/gear> .

ex:w1 a ext:Widget ;
    ext2:size 3 ;
    gear:teeth 12 .
