<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/onto/truncated#"
     xml:base="http://example.org/onto/truncated"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/onto/truncated"/>
    <owl:Class rdf:about="#Dog">
        <rdfs:label>Truncated dog</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="#Cat">
        <rdfs:label>Truncated cat</rdfs:label>
    </owl:Clas>
    <owl:Class rdf:about="#Cow">
        <rdfs:label>Truncated cow</rdfs:label>
    </owl:Class>
</rdf:RDF>
